---
import { formatDate, toPostUrl, type Lang, type Post } from "../lib/blog";

interface Props {
  post: Post;
  lang: Lang;
  readLabel: string;
}

const { post, lang, readLabel } = Astro.props;
---

<article class="post-card">
  <div class="post-card-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
    {post.data.category && <span>{post.data.category}</span>}
  </div>
  <h3><a href={toPostUrl(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="tag-list" aria-label={lang === "zh" ? "文章标签" : "Post tags"}>
      {post.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  <a class="text-link" href={toPostUrl(post)}>
    {readLabel}<span aria-hidden="true"> →</span>
  </a>
</article>
