---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPostsByLang, languages } from "../../lib/blog";
import { sitePath } from "../../lib/paths";

const lang = "zh";
const dictionary = languages[lang];
const posts = await getPostsByLang(lang);
---

<BaseLayout title="秦继深 | 个人博客" description={dictionary.homeDescription} lang={lang} currentPath="/zh/">
  <section
    class="home-hero"
    style={`--hero-image: url("${sitePath("/images/writing-desk.webp")}")`}
  >
    <div class="shell">
      <div class="hero-inner">
        <p class="eyebrow">个人博客 · Personal journal</p>
        <h1>秦继深</h1>
        <h2>{dictionary.homeTitle}</h2>
        <p class="hero-description">{dictionary.homeDescription}</p>
        <div class="hero-actions">
          <a class="primary-link" href={sitePath("/zh/blog/")}>阅读文章</a>
          <a class="secondary-link" href={sitePath("/zh/about/")}>了解更多</a>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band shell">
    <div class="section-heading">
      <h2>{dictionary.latestPosts}</h2>
      <a class="text-link" href={sitePath("/zh/blog/")}>查看全部 →</a>
    </div>
    <div class="post-grid">
      {posts.slice(0, 3).map((post) => (
        <PostCard post={post} lang={lang} readLabel={dictionary.readArticle} />
      ))}
    </div>
  </section>
</BaseLayout>
