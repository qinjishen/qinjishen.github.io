---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPostsByLang, languages } from "../../../lib/blog";

const lang = "zh";
const dictionary = languages[lang];
const posts = await getPostsByLang(lang);
---

<BaseLayout title="文章 | 秦继深" description="秦继深的中文文章" lang={lang} currentPath="/zh/blog/">
  <header class="page-intro shell">
    <p class="eyebrow">Archive</p>
    <h1>{dictionary.allPosts}</h1>
    <p>写作、阅读、技术实践和持续推进的个人项目。</p>
  </header>
  <section class="article-list shell">
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} lang={lang} readLabel={dictionary.readArticle} />
      ))}
    </div>
  </section>
</BaseLayout>
