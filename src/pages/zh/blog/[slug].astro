---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { formatDate, getPostTranslation, getPostsByLang, languages, toPostUrl } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPostsByLang("zh");
  return posts.map((post) => ({
    params: { slug: post.data.permalink },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dictionary = languages.zh;
const translation = await getPostTranslation(post);
---

<BaseLayout
  title={`${post.data.title} | 秦继深`}
  description={post.data.description}
  lang="zh"
  currentPath={`/zh/blog/${post.data.permalink}/`}
>
  <article class="article-shell">
    <header class="article-header">
      <div class="article-meta">
        <span>{dictionary.publishDate}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, "zh")}</time>
        {post.data.updatedDate && (
          <span>{dictionary.updatedDate} {formatDate(post.data.updatedDate, "zh")}</span>
        )}
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {translation && <a class="translation-link" href={toPostUrl(translation)}>Read in English →</a>}
    </header>
    <div class="article-body"><Content /></div>
  </article>
</BaseLayout>
