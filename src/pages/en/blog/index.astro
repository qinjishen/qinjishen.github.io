---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPostsByLang, languages } from "../../../lib/blog";

const lang = "en";
const dictionary = languages[lang];
const posts = await getPostsByLang(lang);
---

<BaseLayout title="Blog | Qin Ji Shen" description="English writing by Qin Ji Shen" lang={lang} currentPath="/en/blog/">
  <header class="page-intro shell">
    <p class="eyebrow">Archive</p>
    <h1>{dictionary.allPosts}</h1>
    <p>Writing on reading, technology, and long-term personal projects.</p>
  </header>
  <section class="article-list shell">
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} lang={lang} readLabel={dictionary.readArticle} />
      ))}
    </div>
  </section>
</BaseLayout>
