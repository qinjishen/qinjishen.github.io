---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPostsByLang, languages } from "../../lib/blog";
import { sitePath } from "../../lib/paths";

const lang = "en";
const dictionary = languages[lang];
const posts = await getPostsByLang(lang);
---

<BaseLayout title="Qin Ji Shen | Personal Blog" description={dictionary.homeDescription} lang={lang} currentPath="/en/">
  <section
    class="home-hero"
    style={`--hero-image: url("${sitePath("/images/writing-desk.webp")}")`}
  >
    <div class="shell">
      <div class="hero-inner">
        <p class="eyebrow">Personal journal · 个人博客</p>
        <h1>Qin Ji Shen</h1>
        <h2>{dictionary.homeTitle}</h2>
        <p class="hero-description">{dictionary.homeDescription}</p>
        <div class="hero-actions">
          <a class="primary-link" href={sitePath("/en/blog/")}>Read the blog</a>
          <a class="secondary-link" href={sitePath("/en/about/")}>About me</a>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band shell">
    <div class="section-heading">
      <h2>{dictionary.latestPosts}</h2>
      <a class="text-link" href={sitePath("/en/blog/")}>View all →</a>
    </div>
    <div class="post-grid">
      {posts.slice(0, 3).map((post) => (
        <PostCard post={post} lang={lang} readLabel={dictionary.readArticle} />
      ))}
    </div>
  </section>
</BaseLayout>
